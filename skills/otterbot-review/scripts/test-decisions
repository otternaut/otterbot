#!/usr/bin/env bash
# Exercise decision boundaries and reject malformed normalized snapshots.
set -euo pipefail
SKILL_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
case "${1:-}" in
  --help|-h) printf 'Usage: test-decisions [--dry-run]\n'; exit 0 ;;
  --dry-run) printf 'Would check decision-cases.tsv and malformed inputs; no host actions.\n'; exit 0 ;;
  '') ;;
  *) printf 'Unknown option\n' >&2; exit 2 ;;
esac
count=0
while read -r name blockers minors coverage context evidence gates risk visual verdict readiness reason; do
  [[ -n "$name" && "$name" != \#* ]] || continue
  args=(--blockers "$blockers" --minors "$minors" --coverage "$coverage" \
    --context "$context" --evidence "$evidence" --gates "$gates" --visual-evidence "$visual")
  [[ "$risk" == - ]] || args+=(--minor-risk "$risk")
  result=$("$SKILL_ROOT/scripts/decide" "${args[@]}")
  [[ "$result" == *"\"verdict\":\"$verdict\""* && "$result" == *"\"readiness\":\"$readiness\""* ]] || {
    printf 'FAIL %s: %s\n' "$name" "$result" >&2; exit 1;
  }
  if [[ "$reason" != - ]]; then
    [[ "$result" == *"\"$reason\""* ]] || { printf 'Missing reason: %s\n' "$name" >&2; exit 1; }
  else
    [[ "$result" == *'"reasons":[]'* ]] || { printf 'Unexpected hold: %s\n' "$name" >&2; exit 1; }
  fi
  count=$((count + 1))
done < "$SKILL_ROOT/evals/decision-cases.tsv"
base=(--blockers 0 --minors 0 --coverage complete --context current --evidence adequate --gates pass --visual-evidence not-required)
invalid_count=0
for invalid in missing duplicate negative unknown legacy-ci missing-risk bad-risk missing-visual bad-visual; do
  case "$invalid" in
    missing-visual) args=("${base[@]:0:12}") ;;
    bad-visual) args=("${base[@]:0:12}" --visual-evidence maybe) ;;
    missing) args=(--blockers 0) ;;
    duplicate) args=("${base[@]}" --minors 1 --minor-risk safe) ;;
    negative) args=(--blockers -1 "${base[@]:2}") ;;
    unknown) args=("${base[@]}" --approve-anyway yes) ;;
    legacy-ci) args=("${base[@]}" --ci ready) ;;
    missing-risk) args=(--blockers 0 --minors 1 "${base[@]:4}") ;;
    bad-risk) args=("${base[@]:0:2}" --minors 1 "${base[@]:4}" --minor-risk maybe) ;;
  esac
  if "$SKILL_ROOT/scripts/decide" "${args[@]}" >/dev/null 2>&1; then
    printf 'Accepted invalid input: %s\n' "$invalid" >&2; exit 1
  fi
  invalid_count=$((invalid_count + 1))
done
# Benign feedback still approves; the opt-out only changes delivery.
review=(--blockers 0 --minors 1 --minor-risk safe --coverage complete --context current --evidence adequate --gates pass --visual-evidence not-required)
result=$("$SKILL_ROOT/scripts/decide" "${review[@]}")
[[ "$result" == '{"verdict":"ship-it","readiness":"review-passed","reasons":[]}' ]]
result=$("$SKILL_ROOT/scripts/decide" "${review[@]}" --no-approve)
[[ "$result" == '{"verdict":"comment-only","readiness":"review-passed","reasons":["approval_opt_out"]}' ]]
# Delivery opt-out must not downgrade real review holds or blockers.
for blockers in 0 1; do
  result=$("$SKILL_ROOT/scripts/decide" --blockers "$blockers" --minors 0 \
    --coverage incomplete --context current --evidence adequate --gates pass --visual-evidence not-required --no-approve)
  [[ "$result" == *'"verdict":"request-changes"'* ]]
done
# Human holds remain comments with zero, one or two safe minors, even opted out.
for minors in 0 1 2; do
  result=$("$SKILL_ROOT/scripts/decide" --blockers 0 --minors "$minors" --minor-risk safe \
    --coverage complete --context current --evidence adequate --gates human-required \
    --visual-evidence not-required --no-approve)
  [[ "$result" == '{"verdict":"requires-human","readiness":"requires-human","reasons":["human_review_required"]}' ]]
done
# Uncertain minor risk and the minor threshold are reported together.
result=$("$SKILL_ROOT/scripts/decide" --blockers 0 --minors 3 --minor-risk uncertain \
  --coverage complete --context current --evidence adequate --gates pass --visual-evidence not-required)
[[ "$result" == '{"verdict":"request-changes","readiness":"blocked","reasons":["minor_threshold","minor_risk"]}' ]]
# A delivery opt-out cannot bypass visual evidence; supplying it clears only that gate.
for visual in missing provided; do
  result=$("$SKILL_ROOT/scripts/decide" "${base[@]:0:12}" --visual-evidence "$visual" --no-approve)
  if [[ "$visual" == missing ]]; then
    [[ "$result" == '{"verdict":"evidence-required","readiness":"blocked","reasons":["missing_visual_evidence"]}' ]]
  else
    [[ "$result" == '{"verdict":"comment-only","readiness":"review-passed","reasons":["approval_opt_out"]}' ]]
  fi
done
printf '%s decision cases, 10 delivery cases and %s invalid-input cases passed.\n' "$count" "$invalid_count"
