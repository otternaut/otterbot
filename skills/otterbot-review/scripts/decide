#!/usr/bin/env bash
# Normalize an evidenced review snapshot into a verdict and code-review status.
# No network, filesystem writes, code execution, or host actions.
set -euo pipefail
usage() {
  cat <<'USAGE'
Usage: decide --blockers N --minors N --coverage complete|incomplete|unknown
  --context current|stale|unknown --evidence adequate|inadequate|unknown
  --gates pass|human-required|hold|unknown [--minor-risk safe|uncertain]
  [--no-approve] [--dry-run]

The six review fields are required; counts are distinct outstanding verified defects.
--minor-risk is required when --minors is nonzero: safe means every counted
minor has a concrete, limited consequence that is safe to address after merge.
Gates includes other code-review gates, never CI/CD or merge eligibility.
human-required means only explicit human review/sign-off is missing. Combined
with other holds it yields request-changes with a human_review_required reason.
--no-approve suppresses approval only for an otherwise passing review.
Outputs JSON only. This helper trusts normalized inputs; it does not verify them.
--dry-run is identical: this command never changes state.
USAGE
}
fail() { printf 'decide: %s\n' "$1" >&2; exit 2; }
seen=' '
no_approve=false
minor_risk=''
while (($#)); do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --dry-run) shift; continue ;;
    --no-approve) no_approve=true; shift; continue ;;
    --blockers|--minors|--coverage|--context|--evidence|--gates|--minor-risk)
      key=${1#--}
      key=${key//-/_}
      [[ "$seen" != *" $key "* ]] || fail "duplicate field: $key"
      (($# >= 2)) || fail "missing value: $key"
      value=$2
      case "$key:$value" in
        blockers:*|minors:*)
          [[ "$value" =~ ^(0|[1-9][0-9]*)$ && ${#value} -le 6 ]] || fail "invalid count: $key" ;;
        coverage:complete|coverage:incomplete|coverage:unknown|context:current|context:stale|context:unknown|evidence:adequate|evidence:inadequate|evidence:unknown|gates:pass|gates:human-required|gates:hold|gates:unknown|minor_risk:safe|minor_risk:uncertain) ;;
        *) fail "invalid value: $key" ;;
      esac
      # Key is from the allowlist, value is validated; never evaluate input.
      printf -v "$key" '%s' "$value"
      seen+="$key "
      shift 2 ;;
    *) fail 'unknown option' ;;
  esac
done
for key in blockers minors coverage context evidence gates; do
  [[ "$seen" == *" $key "* ]] || fail "missing field: $key"
done
if ((minors > 0)) && [[ -z "$minor_risk" ]]; then fail 'missing field: minor-risk (required when minors > 0)'; fi
reasons=()
if ((blockers > 0)); then
  verdict=request-changes
  readiness=blocked
  reasons+=(verified_blockers)
elif ((minors == 0)) && [[ "$coverage" == complete && "$context" == current &&
  "$evidence" == adequate && "$gates" == human-required ]]; then
  verdict=requires-human
  readiness=requires-human
  reasons+=(human_review_required)
else
  [[ "$coverage" == complete ]] || reasons+=(incomplete_coverage)
  [[ "$context" == current ]] || reasons+=(unverified_context)
  [[ "$evidence" == adequate ]] || reasons+=(insufficient_evidence)
  case "$gates" in
    pass) ;;
    human-required) reasons+=(human_review_required) ;;
    *) reasons+=(review_gates) ;;
  esac
  ((minors < 3)) || reasons+=(minor_threshold)
  if ((minors > 0)) && [[ "$minor_risk" == uncertain ]]; then reasons+=(minor_risk); fi
  if ((${#reasons[@]})); then
    verdict=request-changes
    readiness=blocked
  else
    verdict=ship-it
    readiness=review-passed
    if [[ "$no_approve" == true ]]; then
      verdict=comment-only
      reasons+=(approval_opt_out)
    fi
  fi
fi
printf '{"verdict":"%s","readiness":"%s","reasons":[' "$verdict" "$readiness"
sep=''
if ((${#reasons[@]})); then
  for reason in "${reasons[@]}"; do
    printf '%s"%s"' "$sep" "$reason"
    sep=','
  done
fi
printf ']}\n'
